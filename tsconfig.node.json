{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022"],
    "types": ["node"],
    "noEmit": true
  },
  "include": [
    "src/shared/**/*",
    "src/core/**/*",
    "src/services/**/*",
    "src/runtime/**/*",
    "src/cli/**/*",
    "scripts/**/*",
    "tests/unit/**/*",
    "tests/integration/**/*",
    "vite.renderer.config.ts",
    "vitest.config.ts"
  ]
}
